    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.151.0"
  }
